# Configuración del backup cifrado (deploy/backup.sh). Copialo a /opt/mortero/backup.env y protegelo:
#   chmod 600 /opt/mortero/backup.env
# No lo subas a ningún lado.

# Dónde se guardan los backups. Con Cloudflare R2 (un bucket privado, solo para esto):
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/qule-backups
# Token de R2 con permiso de lectura y escritura SOLO sobre ese bucket:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Archivo con la contraseña que cifra los backups (chmod 600). Sin ella NO se pueden recuperar:
# guardala también fuera del servidor, en un gestor de contraseñas de dos personas del equipo.
RESTIC_PASSWORD_FILE=/opt/mortero/restic-password

# Días que se guardan (lo que dice la política de privacidad). No lo subas sin cambiar la política.
KEEP_DAYS=14
